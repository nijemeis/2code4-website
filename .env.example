# Copy to .env and fill in. .env is gitignored; never commit real values.

# --- Keystatic --------------------------------------------------------------
# Leave all five empty for local editing: /keystatic then writes straight to the
# working tree. Fill them in for production, where the filesystem is read-only
# and /keystatic has to commit through GitHub instead.
#
# Don't deploy with these empty. /keystatic is a public route, so a live site
# without them serves an editing UI that loads and then fails on every save.
#
# The four below are produced by the setup wizard at /keystatic/setup once
# PUBLIC_KEYSTATIC_GITHUB_REPO is set. Run that wizard LOCALLY (npm run dev);
# in production the API route throws before it can exchange the GitHub code.
# See https://keystatic.com/docs/github-mode

# "owner/repo", e.g. nijemeis/2code4-website
PUBLIC_KEYSTATIC_GITHUB_REPO=

# The GitHub App's URL slug, e.g. 2code4-keystatic
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=

# Any long random string; signs the editor's session cookie.
# Generate with: openssl rand -hex 32
KEYSTATIC_SECRET=
