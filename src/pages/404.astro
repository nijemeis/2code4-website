---
import Base from '../layouts/Base.astro';
---

<Base title="Not found — 2code4">
  <section class="nf">
    <span class="kicker">404</span>
    <h1 class="h2">That’s nothing, <span class="num">2</span>code<span class="num">4</span>.</h1>
    <p>This page doesn’t exist. The rest of the site does.</p>
    <a href="/" class="btn btn--primary">Back to the start</a>
  </section>
</Base>

<style>
  .nf { padding: 120px 0 160px; display: flex; flex-direction: column; align-items: flex-start; gap: 20px; }
  p { font-size: 16px; line-height: 28px; color: var(--muted); }
</style>
