---
import { getEntry } from 'astro:content';
import Icon from './Icon.astro';
import Reading from './Reading.astro';

const c = (await getEntry('contact', 'contact'))!.data;
---

<section id="contact" class="contact">
  <div>
    {/* Always the opposite reading to the hero. */}
    <h2>
      <Reading reading="back" class="reading--front-in-hero" />
      <Reading reading="front" class="reading--back-in-hero" />
    </h2>
    {c.intro && <p class="intro">{c.intro}</p>}
    <p class="email"><a href={`mailto:${c.email}`}>{c.email}</a></p>
  </div>

  {/* A Netlify Form: detected in the built HTML at deploy, no backend. */}
  <form class="panel" name="contact" method="POST" action="/#contact" data-netlify="true" netlify-honeypot="company" data-contact-form>
    <input type="hidden" name="form-name" value="contact" />
    <p class="visually-hidden" aria-hidden="true">
      <label>Leave this empty <input name="company" tabindex="-1" autocomplete="off" /></label>
    </p>
    <label class="field">Name<input type="text" name="name" autocomplete="name" /></label>
    <label class="field">Email<input type="email" name="email" required autocomplete="email" /></label>
    <label class="field">{c.briefLabel}<textarea name="brief" rows="4" placeholder={c.briefPlaceholder}></textarea></label>
    <fieldset class="kinds">
      <legend>{c.kindLabel}</legend>
      <div class="pills">
        {c.kinds.map((k, i) => (
          <label class="kind"><input type="radio" name="kind" value={k} checked={i === 0} /><span>{k}</span></label>
        ))}
      </div>
    </fieldset>
    <p class="error" role="alert" hidden data-error>
      That didn’t go through. Try again, or email <a href={`mailto:${c.email}`}>{c.email}</a>.
    </p>
    <button type="submit" class="btn btn--primary submit">{c.submitLabel}</button>
  </form>

  <div class="panel success" hidden data-contact-success tabindex="-1">
    <span class="icon-box icon-box--solid"><Icon name="check" size={22} stroke={20} /></span>
    <h3>{c.successTitle}</h3>
    <p class="body">{c.successBody}</p>
    <button type="button" class="btn btn--ghost again" data-contact-reset>Send another</button>
  </div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]')!;
  const success = document.querySelector<HTMLElement>('[data-contact-success]')!;
  const error = form.querySelector<HTMLElement>('[data-error]')!;
  const submit = form.querySelector<HTMLButtonElement>('button[type=submit]')!;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    error.hidden = true;
    submit.disabled = true;
    try {
      const body = new URLSearchParams(new FormData(form) as unknown as Record<string, string>).toString();
      const res = await fetch('/', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body });
      if (!res.ok) throw new Error(String(res.status));
      form.reset();
      form.hidden = true;
      success.hidden = false;
      success.focus();
    } catch {
      error.hidden = false;
    } finally {
      submit.disabled = false;
    }
  });

  document.querySelector('[data-contact-reset]')!.addEventListener('click', () => {
    success.hidden = true;
    form.hidden = false;
    form.querySelector<HTMLInputElement>('input[name=name]')!.focus();
  });
</script>

<style>
  .contact {
    position: relative; margin-bottom: 56px; padding: clamp(28px, 5vw, 56px); border-radius: 24px;
    background: var(--surface); border: 1px solid var(--line); display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 360px), 1fr)); gap: 40px 64px; align-items: start; overflow: hidden;
  }
  h2 { font-size: clamp(38px, 5vw, 64px); line-height: 1.05; letter-spacing: -0.04em; }
  .intro { font-size: 16px; line-height: 28px; max-width: 42ch; margin-top: 24px; color: var(--ink-2); }
  .email { font-size: 15px; font-weight: 600; margin-top: 20px; }

  .panel {
    position: relative; padding: 24px; border-radius: 18px; background: var(--surface);
    box-shadow: 0 18px 48px rgba(21, 20, 31, 0.10); display: flex; flex-direction: column; gap: 16px;
  }
  .panel[hidden] { display: none; }
  .field { display: flex; flex-direction: column; gap: 6px; font-size: 13px; font-weight: 500; color: var(--ink-2); }
  input:not([type='radio']), textarea {
    min-height: 42px; padding: 10px 12px; border: 1px solid var(--line-strong); border-radius: 10px;
    background: var(--bg); font: inherit; font-size: 15px; color: var(--ink);
  }
  textarea { resize: vertical; }
  input:not([type='radio']):focus, textarea:focus { border-color: var(--indigo); outline: 3px solid var(--indigo-focus); outline-offset: 0; }

  .kinds { border: 0; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; min-width: 0; }
  legend { padding: 0; margin-bottom: 8px; font-size: 13px; font-weight: 500; color: var(--ink-2); }
  .pills { display: flex; flex-wrap: wrap; gap: 8px; }
  .kind { position: relative; cursor: pointer; }
  .kind input { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; }
  .kind span {
    display: inline-block; padding: 7px 14px; border-radius: 99px; border: 1px solid var(--line-strong);
    background: var(--surface); color: var(--ink-2); font-size: 13px; font-weight: 500;
  }
  .kind input:checked + span { background: var(--indigo); border-color: var(--indigo); color: var(--surface); }
  .kind input:focus-visible + span { outline: 2px solid var(--indigo); outline-offset: 2px; }

  .error { font-size: 13px; color: #b42318; }
  .submit { align-self: flex-start; margin-top: 4px; }
  .submit:disabled { opacity: 0.6; cursor: progress; }

  .success { padding: 28px; gap: 10px; }
  .success:focus { outline: none; }
  .success h3 { font-size: 22px; letter-spacing: -0.02em; }
  .again { align-self: flex-start; padding: 8px 12px; }
</style>
