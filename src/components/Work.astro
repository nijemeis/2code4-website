---
import { getCollection, getEntry } from 'astro:content';
import ProjectCard from './ProjectCard.astro';

const w = (await getEntry('work', 'work'))!.data;
const projects = (await getCollection('projects')).map((e) => e.data).sort((a, b) => a.order - b.order);
const featured = projects.filter((p) => p.featured);
const rest = projects.filter((p) => !p.featured);
---

<section id="work" class="work">
  <span class="kicker">{w.kicker}</span>
  <div class="head">
    <h2 class="h2" style="max-width: 18ch">{w.title}</h2>
    {w.intro && <p class="intro">{w.intro}</p>}
  </div>

  {featured.length > 0 && (
    <div class="grid grid--featured">{featured.map((p) => <ProjectCard project={p} featured />)}</div>
  )}
  {rest.length > 0 && (
    <div class="grid grid--small">{rest.map((p) => <ProjectCard project={p} />)}</div>
  )}
</section>

<style>
  .work { padding: 84px 0; }
  .head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 16px 48px; }
  .intro { font-size: 15.5px; line-height: 26px; max-width: 46ch; color: var(--muted); }
  .grid { display: grid; }
  .grid--featured { grid-template-columns: repeat(auto-fit, minmax(min(100%, 360px), 1fr)); gap: 20px; margin-top: 44px; }
  .grid--small { grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr)); gap: 16px; margin-top: 44px; }
  .grid--featured + .grid--small { margin-top: 16px; }
</style>
