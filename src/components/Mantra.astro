---
interface Props {
  words: string[];
  small?: boolean;
}
const { words, small = false } = Astro.props;
---

<span class:list={['mantra', { 'mantra--small': small }]}>
  {words.map((w, i) => (
    <>
      {i > 0 && <span class="dot" aria-hidden="true" />}
      <span>{w}</span>
    </>
  ))}
</span>

<style>
  .mantra {
    display: inline-flex; flex-wrap: wrap; align-items: center; gap: 6px 10px;
    font-family: var(--mono); font-size: 15px; font-weight: 600; letter-spacing: 0.02em; color: var(--indigo-dark);
  }
  .mantra--small { font-size: 12px; color: var(--ink-2); }
  .dot { width: 4px; height: 4px; border-radius: 50%; background: var(--yellow); }
</style>
